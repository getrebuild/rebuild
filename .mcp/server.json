{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.getrebuild/rebuild-mcp",
  "title": "REBUILD MCP",
  "description": "REBUILD platform MCP server for entity query, record CRUD, report export and more",
  "version": "4.5.0",
  "websiteUrl": "https://getrebuild.com",
  "icons": [
    {
      "src": "https://getrebuild.com/favicon.ico",
      "mimeType": "image/png",
      "sizes": ["any"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "{server_url}/gw/mcp/sse",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token using your personal API Key (AK) from REBUILD",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {RB_AK}"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/getrebuild/rebuild",
    "source": "github"
  }
}
